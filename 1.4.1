class Solution {
private:
    ListNode* reverseList(ListNode* head) {
        ListNode* prev = nullptr;
        while (head) {
            ListNode* nxt = head->next;
            head->next = prev;
            prev = head;
            head = nxt;
        }
        return prev;
    }

public:
    bool isPalindrome(ListNode* head) {
        if (!head || !head->next) return true;

        // Find middle (slow will point to start of second half for even length,
        // or middle node for odd length; we want start of second half)
        ListNode* slow = head;
        ListNode* fast = head;
        while (fast && fast->next) {
            slow = slow->next;
            fast = fast->next->next;
        }

        // For odd length, move slow one step to skip the middle element
        if (fast) { // fast != nullptr means odd number of nodes
            slow = slow->next;
        }

        // Reverse second half
        ListNode* second = reverseList(slow);
        ListNode* first = head;

        // Compare halves
        ListNode* p2 = second;
        bool palindrome = true;
        while (p2) {
            if (first->val != p2->val) {
                palindrome = false;
                break;
            }
            first = first->next;
            p2 = p2->next;
        }

        // Restore the list (optional)
        reverseList(second);

        return palindrome;
    }
};

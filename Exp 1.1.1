class Solution {
public:
    bool containsNearbyDuplicate(vector<int>& nums, int k) {
        unordered_map<int, int> last_seen;
        for (int i = 0; i < nums.size(); i++) {
            auto it = last_seen.find(nums[i]);
            if (it != last_seen.end() && i - it->second <= k) {
                return true;
            }
            last_seen[nums[i]] = i;
        }
        return false;
    }
};
